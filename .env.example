# 對應 docs/PROJECT_PLAN.md 〈二、技術架構 §8.3〉
# 實際做法:`vercel link` 之後跑 `vercel env pull .env.local`,唔好手動抄呢個檔案。

# Neon Postgres(Vercel Marketplace provision 之後自動注入)
DATABASE_URL=

# Auth.js JWT 簽名密鑰 —— 用 `npx auth secret` 生成
AUTH_SECRET=

# Seed 完之後填入嗰行 restaurants.id(V1 tenant 解析用)
DEFAULT_RESTAURANT_ID=

# Vercel Blob(provision 之後自動注入)
BLOB_READ_WRITE_TOKEN=

# AI Gateway 唔需要手動 key,OIDC 自動處理(vercel env pull 產生 VERCEL_OIDC_TOKEN)
